# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild during development.
DISCORD_GUILD_ID=
# Slash-command registration at startup: auto (only when definitions changed,
# tracked in COMMANDS_HASH_FILE) | always | off. Force with `pnpm commands:register`.
# COMMANDS_REGISTER_MODE=auto
# COMMANDS_HASH_FILE=.runtime/commands.hash

# --- Database ---
# PostgreSQL connection string (Supabase). Find it in Supabase:
# Project Settings → Database → Connection string (URI). SSL is required.
# Direct connection uses port 5432; the transaction pooler uses 6543.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
# Operator-facing text; edits apply without a restart.
# MESSAGES_FILE=apps/bot/messages/zh-TW.json
# Graceful-shutdown cap (ms); keep below PM2 kill_timeout (10000).
# SHUTDOWN_TIMEOUT_MS=8000

# --- Activity tunables (optional; domain defaults apply if unset) ---
# ACTIVITY_TIME_ZONE=Asia/Taipei
# ACTIVITY_CHAT_COOLDOWN_MS=60000
# ACTIVITY_VOICE_DAILY_CAP_SECONDS=14400
# ACTIVITY_INTERACTION_DAILY_CAP=20
# ACTIVITY_IMAGE_DAILY_CAP=10
# ACTIVITY_MUSIC_DAILY_CAP=10
# ACTIVE_MEMBER_WINDOW_DAYS=30
# ACTIVE_MEMBER_CRON=0 4 * * *
# EMBED_DRAFT_TTL_MINUTES=60

# --- Moderation tunables (optional; domain defaults apply if unset) ---
# Default honeypot timeout when a channel sets no per-channel duration.
# HONEYPOT_TIMEOUT_SECONDS=600

# --- Dynamic voice tunables (optional) ---
# Grace window before an emptied dynamic voice channel is deleted (seconds).
# 0 = delete immediately. Lets a brief disconnect/reconnect keep the room.
# DYNAMIC_VOICE_EMPTY_GRACE_SECONDS=60

# --- Local admin panel (optional) ---
# Served only on 127.0.0.1 (never configurable); open http://127.0.0.1:2615/.
# For remote access use your own SSH tunnel — do not expose the port.
# ADMIN_PANEL_ENABLED=true
# ADMIN_PANEL_PORT=2615
